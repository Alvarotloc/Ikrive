{
  "name": "ikrive",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hosted, private vehicle management",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ikrive/api --filter @ikrive/web dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm build && pnpm --filter @ikrive/e2e test:e2e",
    "screenshots": "pnpm build && pnpm --filter @ikrive/e2e screenshots",
    "db:generate": "pnpm --filter @ikrive/db db:generate",
    "db:migrate": "pnpm --filter @ikrive/api db:migrate",
    "harness": "node scripts/harness/check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
