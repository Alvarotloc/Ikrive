# Public URL where Ikrive is reachable (used for auth cookies and links in notifications).
BASE_URL=http://localhost:3000

# Required in production. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Time zone used by scheduled reminders.
TZ=Europe/Madrid

# Set to true after creating your accounts to block new sign-ups.
DISABLE_SIGNUP=false

# Maximum size of uploaded invoices/photos, in MB.
MAX_UPLOAD_MB=20

# PORT=3000
# DATA_DIR=./data
# LOG_LEVEL=info
