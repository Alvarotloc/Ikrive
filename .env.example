# All the variables, their defaults and which ones the image sets: docs/self-hosting.md

# Public URL where Ikrive is reachable (used for auth cookies and links in notifications).
BASE_URL=http://localhost:3000

# Required in production. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Time zone of the server logs. Reminders use each user's time zone and hour from Settings.
TZ=Europe/Madrid

# Set to false to stop the hourly job that creates maintenance reminders.
REMINDERS_ENABLED=true

# Set to true after creating your accounts to block new sign-ups.
DISABLE_SIGNUP=false

# Maximum size of uploaded invoices/photos, in MB.
MAX_UPLOAD_MB=20

# Total size, in MB, of the invoices appended to one sale report; the ones that do not fit are
# skipped with a notice in the report.
REPORT_MAX_ANNEX_MB=100

# Maximum size, in MB, of an export zip uploaded to import it (and of its uncompressed contents).
IMPORT_MAX_MB=1024

# PORT=3000
# Inside the Docker image the data lives in /data (the mounted volume): do not change it there.
# DATA_DIR=/data
# LOG_LEVEL=info
