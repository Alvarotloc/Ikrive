{
  "name": "@ikrive/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "job": "tsx --env-file-if-exists=../../.env src/job.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "0.20.1",
    "react": "^19.3.0",
    "sharp": "0.35.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ikrive/db": "workspace:*",
    "@ikrive/shared": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "unpdf": "^2.1.0"
  }
}
